# Backend settings. Copy to backend/.env and fill in the values.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GROQ_MODEL=

# Testing switch for the School Result Compiler.
# true  = no plan, no payment, no student capacity limit (evaluation mode)
# false = the real subscription rules apply (default when unset)
# Only the exact value "true" switches the gates off.
SUBSCRIPTION_TEST_MODE=false

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Reads photographs of handwritten registers (free tier at aistudio.google.com).
GEMINI_API_KEY=
